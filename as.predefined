// Currently this is manual writing until i learn how to add the doc strings

void print(const string &in);
void println(const string &in);

// Raises a generic Exception with the given message
void SetException( const string&in message, dictionary@ data = null );

class Exception
{
    string message;
    string func;
    string sect;
    string stack;
    int line;
    dictionary data;
}

Exception@ GetException();

class optional<T>
{
    optional();
    bool has_value() const;
    void clear();
    const T& value() const;
    void set(const T &in value);
    optional<T>& opAssign(const T &in value);
}

bool Dispose( ?&in obj );

class JSON
{
    // Factory
    JSON@ JSON();
    JSON@ JSON( const string &in value, bool isSerialized = false );
    JSON@ JSON( int value );
    JSON@ JSON( float value );
    JSON@ JSON( bool value );

    // when false; JSON will silent fail. when true; JSON will raise exceptions.
    bool strict;

    // Alias to json::dumps using indents -1 and error_handler_t::ignore. this is exception-safe to print or debug in AS
    string to_string() const;

    bool is_null() const;
    bool is_boolean() const;
    bool is_number() const;
    bool is_number_integer() const;
    bool is_number_unsigned() const;
    bool is_number_float() const;
    bool is_object() const;
    bool is_array() const;
    bool is_string() const;
    bool is_primitive() const;
    // Either json object or array
    bool is_structured() const;
}

namespace json
{
    // Error handlers for dump/s
    enum error_handler
    {
        // throw a type_error exception in case of invalid UTF-8
        strict,
        // replace invalid UTF-8 sequences with U+FFFD
        replace,
        // ignore invalid UTF-8 sequences
        ignore
    };

    // Load and parse json using the FileSystem
    JSON@ load( const string&in filePath, bool ignore_comments = true );

    // Load and parse json using string
    JSON@ loads( const string&in serialized, bool ignore_comments = true );

    // Return a string representing the serialized given object
    string dumps( const JSON@ obj, int indents = -1, error_handler errors = error_handler::strict );

    // Write a serialized representation of the given object in the given file.
    bool dump( const JSON@ obj, const string&in filePath, int indents = -1, error_handler errors = error_handler::strict );
}

// Namespace containing API specifically for this project's Tests
namespace Tests
{
    // Sum if your test failed
    int Fails = 0;
    // Sum if your test passed
    int Passes = 0;

    // Print "Failed/Passed {title}" messages whatever expected is equal to condition.
    // This updates the Fails & Passes counts accordingly
    // Return whatever failed or passed.
    bool Expect( const string&in title, bool expected, bool condition );
}
