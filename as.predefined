/// Addon: ASConsole
namespace Console
{
    /// Console color.
    enum Color
    {
        /// Console text color.
        ForeGround,
        /// Console background color.
        BackGround,
        /// Both console text and background colors.
        Both
    }
    /// Print to the console.
    void Write(const string&in msg);
    /// Print line to the console.
    void WriteLine(const string&in msg);
    /// Print line to the console.
    void WriteLine();
    /// Set the console color code based on the given RGB values.
    void SetColor(Color target, int red, int green, int blue);
    /// Reset the console color code.
    void ResetColor(Color target = Color::Both);
    /// Represents the text color in the console output.
    string ForegroundColor;
    /// Represents the background color in the console output.
    string BackgroundColor;
}
/// Addon: ASException
namespace Exception
{
    /// Raises a script exception. if canCatch is false the script's catch block won't be called.
    void Throw(const string&in exception, bool canCatch = true);
    /// Raises a script exception with aditional metadata dictionary. if canCatch is false the script's catch block won't be called.
    void Throw(const string&in exception, dictionary@ additionalData, bool canCatch = true);
    /// Releases reference to the last exception. by default exceptions are cleared when new ones are created. Call this method after a catch block to clear all members.
    void Clear();
    /// Get the current exception count. this value only increases for explicit script-throw exceptions.
    int Id();
    /// Line of where the exception was raised.
    int Line();
    /// Get the current exception message.
    string Message();
    /// Get the call stack in string form.
    string CallStack();
    /// Get the path to the script that raised the last exception.
    void ScriptSection(string&out absolute = void, string&out relative = void, string&out fileName = void, string&out methodName = void, string&out nameSpace = void, string&out objectName = void);
    /// Get a handle to the dictionary data if the exception provided one when raised.
    dictionary@ Dictionary();
}
/// Addon: Tests
namespace Tests
{
    /// Tests an assertion condition and increments pass/fail counters.
    bool Expect(const string&in title, bool expected, bool condition);
    /// Number of passed test assertions.
    int Passes;
    /// Number of failed test assertions.
    int Fails;
}
/// Addon: ASJSON
namespace json
{
    /// Specifies error handling strategy during JSON serialization and deserialization.
    enum error_handler
    {
        /// Throw a type_error exception on invalid UTF-8 sequences.
        strict,
        /// Replace invalid UTF-8 sequences with U+FFFD.
        replace,
        /// Ignore invalid UTF-8 sequences.
        ignore
    }
    /// Parses a serialized JSON string.
    JSON@ loads(const string&in serialized, bool ignore_comments = true);
    /// Serializes a JSON object into a formatted string.
    string dumps(const JSON@ obj, int indents = -1, error_handler errors = error_handler::strict);
}
