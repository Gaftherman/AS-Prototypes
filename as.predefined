class optional<T>
{
    /// Returns true if the optional contains a value, false otherwise.
    bool has_value() const;
    /// Clears the contained value and resets the optional to an empty state.
    void clear();
    /// Returns a reference to the contained value. Throws a script exception if empty.
    const T& value() const;
    /// Sets the value contained in the optional.
    void set(const T&in value);
    /// Assigns a new value to the optional container.
    optional<T>& opAssign(const T&in value);
}
/// Addon: ASJSON
/// JSON value container supporting null, boolean, number, string, array, and object types.
class JSON
{
    /// Returns a string representation of the JSON object.
    string to_string() const;
    /// Returns true if the JSON value is null.
    bool is_null() const;
    /// Returns true if the JSON value is a boolean.
    bool is_boolean() const;
    /// Returns true if the JSON value is a number.
    bool is_number() const;
    /// Returns true if the JSON value is an integer number.
    bool is_number_integer() const;
    /// Returns true if the JSON value is an unsigned integer number.
    bool is_number_unsigned() const;
    /// Returns true if the JSON value is a floating point number.
    bool is_number_float() const;
    /// Returns true if the JSON value is an object.
    bool is_object() const;
    /// Returns true if the JSON value is an array.
    bool is_array() const;
    /// Returns true if the JSON value is a string.
    bool is_string() const;
    /// Returns true if the JSON value is a primitive type (null, boolean, number, or string).
    bool is_primitive() const;
    /// Returns true if the JSON value is structured (object or array).
    bool is_structured() const;
    /// Defines how should json handle errors.
    json::error_handler m_ErrorHandlerMode;
}
