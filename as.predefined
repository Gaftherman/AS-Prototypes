// Currently this is manual writing until i learn how to add the doc strings

void print(const string &in);
void println(const string &in);

// Raises a generic Exception with the given message
void SetException( const string&in message, dictionary@ data = null );

class Exception
{
    string message;
    string func;
    string sect;
    string stack;
    int line;
    dictionary data;
}

Exception@ GetException();

class optional<T>
{
    optional();
    bool has_value() const;
    void clear();
    const T& value() const;
    void set(const T &in value);
    optional<T>& opAssign(const T &in value);
}

bool Dispose( ?&in obj );

// Namespace containing API specifically for this project's Tests
namespace Tests
{
    // Sum if your test failed
    int Fails = 0;
    // Sum if your test passed
    int Passes = 0;

    // Print "Failed/Passed {title}" messages whatever expected is equal to condition.
    // This updates the Fails & Passes counts accordingly
    // Return whatever failed or passed.
    bool Expect( const string&in title, bool expected, bool condition );
}
